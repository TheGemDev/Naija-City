# Copy to .env and fill in. Vite builds these into the game page, so only put public values here.

# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Sentry error reporting for the game client (leave empty to turn it off)
VITE_SENTRY_DSN=

# Optional: Cloudflare Turnstile bot check on sign-up (leave empty to turn it off)
VITE_TURNSTILE_SITE_KEY=
