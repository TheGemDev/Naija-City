{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kaduna-life",
	"account_id": "ac253828651d75d7188974b0eea16867",
	"main": "worker/index.ts",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-10-01",
	// Sentry's Worker SDK needs Node compatibility.
	"compatibility_flags": ["nodejs_compat"],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"observability": {
		"enabled": true
	},
	"rules": [
		{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": false }
	],
	// The built game. /api/* goes to the Worker first; everything else is static, with SPA fallback.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/",
			"/api/*",
			"/u/*",
			"/b/*",
			"/p/*",
			"/s/*",
			"/shop/*",
			"/t/*",
			"/sitemap.xml",
			"/cities",
			"/cities/*"
		]
	},
	// Production domains: naija.city is the main one, kaduna.life the old one that still works. Both zones must be on
	// this Cloudflare account; the workers.dev URL keeps working too.
	"routes": [
		{
			"pattern": "kaduna.life",
			"custom_domain": true
		},
		{
			"pattern": "www.kaduna.life",
			"custom_domain": true
		},
		{
			"pattern": "naija.city",
			"custom_domain": true
		},
		{
			"pattern": "www.naija.city",
			"custom_domain": true
		},
		{
			"pattern": "stats.naija.city",
			"custom_domain": true
		},
		{
			"pattern": "dash.naija.city",
			"custom_domain": true
		}
	],
	// Keep variables added in the dashboard when Workers Builds deploys from git. Put real secrets in with `wrangler secret put` instead.
	"keep_vars": true,
	"vars": {
		"FIREBASE_PROJECT_ID": "naija-city",
		"ADMIN_HOST": "dash.naija.city",
		"CF_ACCOUNT_ID": "ac253828651d75d7188974b0eea16867",
		"CF_RUM_SITE_TAGS": "132bf643f535419ba3a217e55bef278d,53e41e9a561f43108d047fcce959a2a8",
		"CF_COUNT_FROM": "2026-10-08",
		"SENTRY_DSN": "https://790769217a3087baf9b2b88e264ca3f0@o4512237133561856.ingest.de.sentry.io/4512237156827216",
		"BACHS_BASE_URL": "https://api.bachs.io"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kaduna-life",
			"database_id": "657bc5ac-10a7-4984-a345-26c522ccd3b2",
			"migrations_dir": "migrations"
		}
	],
	// Smart Placement runs the Worker near D1 instead of near the player, which is faster for chatty routes.
	"placement": {
		"mode": "smart"
	},
	// ROOM: one live room per shard (worker/shards.ts). LOBBY: the single directory that knows how full each shard is.
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "Room"
			},
			{
				"name": "LOBBY",
				"class_name": "Lobby"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Room"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Lobby"
			]
		}
	],
	// Background jobs (web push). Create first: npx wrangler queues create kaduna-jobs
	"queues": {
		"producers": [
			{
				"binding": "JOBS",
				"queue": "kaduna-jobs"
			}
		],
		"consumers": [
			{
				"queue": "kaduna-jobs",
				"max_batch_size": 25,
				"max_batch_timeout": 5,
				"max_retries": 3
			}
		]
	},
	// Settles rent, bets, elections, EFCC cases and manhunts even when nobody is looking, and samples online players.
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	// Per-player and per-IP limits. period is 10 or 60 seconds.
	"ratelimits": [
		{
			"name": "RL_API",
			"namespace_id": "1001",
			"simple": {
				"limit": 600,
				"period": 60
			}
		},
		{
			"name": "RL_SENSITIVE",
			"namespace_id": "1002",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "RL_PUBLIC",
			"namespace_id": "1003",
			"simple": {
				"limit": 600,
				"period": 60
			}
		}
	],
	// Player uploads. Create first: npx wrangler r2 bucket create kaduna-media
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "kaduna-media"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	// Public stats snapshot (visits), refreshed by the cron so the stats page never reads D1 per request.
	"kv_namespaces": [
		{
			"binding": "STATS_KV",
			"id": "1fac775cc8b84b97a042f2873972ee58"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "METRICS",
			"dataset": "kaduna_metrics"
		}
	]
}